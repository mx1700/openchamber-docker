# Image built by GitHub Actions. Replace the owner with your GitHub username/org.
# Example: ghcr.io/octocat/openchamber:latest
OPENCHAMBER_IMAGE=ghcr.io/mx1700/openchamber:latest

# Required: browser UI password. Use a long random value.
OPENCHAMBER_UI_PASSWORD=change-me

# Required: stable secret for UI auth tokens. Use a long random value.
# Generate with: openssl rand -hex 32
OPENCODE_JWT_SECRET=change-me

# Required: Tunnel Token from Cloudflare Zero Trust -> Networks -> Tunnels.
# Copy the part after --token in the connector command.
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...

# LAN access. LAN_BIND can be 0.0.0.0 or a specific LAN IP such as 192.168.1.50.
LAN_BIND=0.0.0.0
LAN_PORT=8080
# Used for pairing links / QR codes. Set to your LAN or public URL.
OPENCHAMBER_LAN_URL=http://192.168.1.50:8080

# Optional
TZ=Asia/Shanghai
